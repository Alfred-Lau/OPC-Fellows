# Copy to .env (never commit the real file). All of these are optional.

# Overrides Settings → Model. Prefer the in-app key store for daily use.
DEEPSEEK_API_KEY=

# Workbench userData passed into the opc dsh profile (notes.json lives here).
# OPC_USER_DATA=

# Module overrides. Leave empty unless you are developing that occupation.
# OWNWORKBUDDY_STATS_KEY=
# CREEM_API_KEY=
# HTTPS_PROXY=

# macOS signing / notarization. Set in the shell, not in git.
# CODESIGN_IDENTITY=
# NOTARY_PROFILE=
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=
