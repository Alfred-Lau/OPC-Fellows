# 复制成 .env 再改。仓库根目录的 .gitignore 会忽略 .env 与 .env.*，
# 但会保留 .env.example —— 请不要把带真值的 .env 提交进 git。

# ---------------------------------------------------------------------------
# 必需：所有 /v1/* 接口的 Bearer token。
# 必须换成强随机值，不要用这里的示例、不要用手打的短语：
#     openssl rand -hex 32
# 留空或短于 16 字符时，服务会拒绝启动（fail fast）。
SERVER_TOKEN=

# ---------------------------------------------------------------------------
# server 容器发布到宿主机的端口。
# docker-compose.yml 只把它绑定到 127.0.0.1，公网访问请在前置反向代理上做 TLS。
SERVER_PORT=8787

# ---------------------------------------------------------------------------
# Postgres。docker compose 用这几个变量创建数据库，
# 并自动拼出容器内的 DATABASE_URL（所以你不必手写 localhost / db 的地址）。
POSTGRES_USER=opc
POSTGRES_PASSWORD=
POSTGRES_DB=opc_fellows

# 如果你不用 docker compose（比如托管数据库），直接给完整连接串：
#     DATABASE_URL=postgres://user:password@host:5432/dbname
# DATABASE_URL=

# ---------------------------------------------------------------------------
# 可选：CORS 白名单（逗号分隔）。留空 = 完全关闭，这是默认值。
# 只填你自己的前端来源，例如 https://app.example.com。
# 填 "*" 会被服务拒绝启动 —— 通配 CORS + Bearer token 等于把接口交给任何网页。
# CORS_ORIGIN=

# 可选：请求体上限（字节）与超时（毫秒）。默认 1 MiB / 15000 ms。
# MAX_BODY_BYTES=1048576
# REQUEST_TIMEOUT_MS=15000

# 可选：日志级别 error | warn | info | debug。默认 info。
# LOG_LEVEL=info

# 可选：HOST。默认 127.0.0.1（只监听本机）。
# 容器里 docker-compose.yml 会显式设成 0.0.0.0，端口发布仍由宿主侧的
# 127.0.0.1 绑定来限制暴露面。
# HOST=127.0.0.1
